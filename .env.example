# Copy to .env (git-ignored, not synced by Syncthing) for the audience server's cloud side.
# Azure portal > Web PubSub "sophiaantipolis" > Keys > Connection string (primary)
PUBSUB_CONNECTION_STRING=Endpoint=https://<name>.webpubsub.azure.com;AccessKey=...;Version=1.0;
# the room the server hosts; the phones' QR code carries ?room=<the same>
ROOM=reymenta
