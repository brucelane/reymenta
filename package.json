{
  "name": "reymenta",
  "version": "6.11.19.8",
  "private": true,
  "description": "Reymenta: the audience plays along with the AV set from their phones (live.videodromm.com)",
  "license": "AGPL-3.0-or-later",
  "author": "Bruce Lane",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode phone",
    "server": "tsx src/server/main.ts",
    "bots": "tsx scripts/fake-phones.ts",
    "show-qr": "node scripts/show-qr.mjs",
    "emoji-atlas": "node scripts/emoji-atlas.mjs",
    "build": "tsc --noEmit && vite build",
    "buildandroid": "tsc --noEmit && vite build && npx cap sync android && npx cap open android",
    "androidassets": "npx @capacitor/assets generate --android --assetPath resources",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "sync-core": "node scripts/sync-core.mjs",
    "deploy:android": "node scripts/deploy-android.mjs",
    "deploy:android:release": "node scripts/deploy-android.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.11",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/web": "1.3.0",
    "bonjour-service": "1.3.0",
    "capacitor-lan": "file:plugins\\capacitor-lan",
    "hydra-synth": "1.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xmldom/xmldom": "0.9.12",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
